rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ═══════════════════════════════════════════════════════════════
    // SECURITY RULES - HIGH SECURITY MODE
    // Only allow access from your domain
    // ═══════════════════════════════════════════════════════════════
    
    // Helper function - check if request is from authorized domain
    function isAuthorizedDomain() {
      return request.headers['origin'] == 'https://abdallah1984albliwi.github.io';
    }
    
    // Helper function - check if request is from localhost (for testing)
    function isLocalhost() {
      return request.headers['origin'] != null && 
             (request.headers['origin'].matches('http://localhost.*') ||
              request.headers['origin'].matches('http://127.0.0.1.*'));
    }
    
    // Allow access only from authorized domains
    function isAllowedOrigin() {
      return isAuthorizedDomain() || isLocalhost();
    }
    
    // ═══════════════════════════════════════════════════════════════
    // USERS COLLECTION - Read only from authorized domains
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId} {
      // Allow read from authorized domains only
      allow read: if isAllowedOrigin();
      
      // Deny all writes from web
      // Users can only be modified in code (initDB function)
      allow write: if false;
    }
    
    // ═══════════════════════════════════════════════════════════════
    // STUDENTS COLLECTION - Full protection
    // ═══════════════════════════════════════════════════════════════
    match /students/{studentId} {
      // Allow read only from authorized domains
      allow read: if isAllowedOrigin();
      
      // Allow write only from authorized domains
      allow write: if isAllowedOrigin();
      
      // Prevent mass deletion
      allow delete: if isAllowedOrigin() && 
                       request.time < timestamp.date(2027, 1, 1); // Expire in 2027
    }
    
    // ═══════════════════════════════════════════════════════════════
    // DENY ALL OTHER COLLECTIONS
    // ═══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
